<Window x:Class="Switch2ProManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switch 2 Pro Manager" Width="1040" Height="800" MinWidth="940" MinHeight="720"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Colours come from SystemColors so they follow the light/dark theme. -->
        <SolidColorBrush x:Key="Hairline" Color="#55888888"/>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Fill" Value="#9E9E9E"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Scanning"><Setter Property="Fill" Value="#F5A623"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Connecting"><Setter Property="Fill" Value="#F5A623"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Connected"><Setter Property="Fill" Value="#2ECC71"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ Left column: connection ══════════ -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Switch 2 Pro Manager" FontSize="22" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
                    <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}" Padding="12,8" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Connect" Command="{Binding ConnectCommand}" Padding="12,8"/>
                    <Button Grid.Column="2" Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="12,8"/>
                </Grid>

                <TextBlock Text="Devices found" Margin="0,18,0,6" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Content="Emulate Xbox 360 pad (ViGEm)" IsChecked="{Binding VirtualPadEnabled}"/>
                        <CheckBox Content="Positional layout (Nintendo B → Xbox A)" IsChecked="{Binding PositionalLayout}" Margin="0,8,0,0"/>
                        <CheckBox Content="Capture button → F12 (Steam screenshots)" IsChecked="{Binding CaptureToF12}" Margin="0,8,0,0"/>
                        <CheckBox Content="Read motion: accelerometer and gyroscope (experimental)" IsChecked="{Binding MotionEnabled}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding PadStatus}" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <CheckBox Content="Game rumble (via virtual Xbox pad)" IsChecked="{Binding GameRumbleEnabled}"/>
                        <Button Content="Test rumble" Command="{Binding TestHapticsCommand}" Margin="0,8,0,0" Padding="12,6"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding BatteryText}"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding BatteryPercent}" Height="8" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AddressText}" FontSize="12" Opacity="0.7"/>
                            <TextBlock Text="{Binding Hint}" FontSize="12" Opacity="0.7"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ══════════ Right column: live test panel ══════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Live test panel" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Stick izquierdo -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Grid Width="130" Height="130">
                                <Ellipse Stroke="{StaticResource Hairline}" StrokeThickness="2"/>
                                <Ellipse Style="{StaticResource Dot}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="{Binding LeftDotX}" Y="{Binding LeftDotY}"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="Left stick" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Gatillos -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="ZL"/>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ZlValue}" Height="10" Margin="0,4,0,14"/>
                            <TextBlock Text="ZR"/>
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ZrValue}" Height="10" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Stick derecho -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Grid Width="130" Height="130">
                                <Ellipse Stroke="{StaticResource Hairline}" StrokeThickness="2"/>
                                <Ellipse Style="{StaticResource Dot}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="{Binding RightDotX}" Y="{Binding RightDotY}"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="Right stick" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MotionText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Opacity="0.8" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Padding="12,6" MinWidth="46" CornerRadius="6"
                                    BorderThickness="1" BorderBrush="{StaticResource Hairline}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPressed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Expander Header="HD rumble lab (experimental)" IsExpanded="False">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                       Text="Built-in vibration samples (documented command, also used by the console):"/>
                            <ItemsControl ItemsSource="{Binding Samples}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Margin="0,0,6,6" Padding="10,4"
                                                Command="{Binding DataContext.PlaySampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0"
                                       Text="Direct HD frames per actuator. Do not leave amplitudes high for long. The code → Hz mapping is undocumented: explore it."/>
                            <CheckBox Content="Send lab rumble" IsChecked="{Binding LabEnabled}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding LabHighFreq, StringFormat='High-band frequency (code): {0:0}'}" Margin="0,6,0,0"/>
                            <Slider Minimum="0" Maximum="511" Value="{Binding LabHighFreq}"/>
                            <TextBlock Text="{Binding LabLowFreq, StringFormat='Low-band frequency (code): {0:0}'}" Margin="0,6,0,0"/>
                            <Slider Minimum="0" Maximum="511" Value="{Binding LabLowFreq}"/>
                            <TextBlock Text="{Binding LabLeftHigh, StringFormat='Left · high-band amplitude: {0:0}'}" Margin="0,6,0,0"/>
                            <Slider Minimum="0" Maximum="453" Value="{Binding LabLeftHigh}"/>
                            <TextBlock Text="{Binding LabLeftLow, StringFormat='Left · low-band amplitude: {0:0}'}" Margin="0,6,0,0"/>
                            <Slider Minimum="0" Maximum="453" Value="{Binding LabLeftLow}"/>
                            <TextBlock Text="{Binding LabRightHigh, StringFormat='Right · high-band amplitude: {0:0}'}" Margin="0,6,0,0"/>
                            <Slider Minimum="0" Maximum="453" Value="{Binding LabRightHigh}"/>
                            <TextBlock Text="{Binding LabRightLow, StringFormat='Right · low-band amplitude: {0:0}'}" Margin="0,6,0,0"/>
                            <Slider Minimum="0" Maximum="453" Value="{Binding LabRightLow}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Research: Bluetooth headset audio (experimental)" Margin="0,8,0,0" IsExpanded="False">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                       Text="Status: the controller accepts writes on the output characteristic but only buzzes; no sound reaches the headphones. See docs/AUDIO_RESEARCH.md. Test with the headphones OFF your ears and the level on quiet."/>
                            <ComboBox ItemsSource="{Binding ProbeVariants}" SelectedIndex="{Binding ProbeVariantIndex}" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox Content="Normal level (louder)" IsChecked="{Binding ProbeNormalLevel}" VerticalAlignment="Center"/>
                                <Button Content="Send test tone (3 s)" Command="{Binding ProbeAudioCommand}" Margin="16,0,0,0" Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Capture headset input (10 s)" Command="{Binding CaptureHeadsetCommand}" Padding="10,4"/>
                                <Button Content="Save GATT dump" Command="{Binding DumpGattCommand}" Margin="8,0,0,0" Padding="10,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding LogLines}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             BorderThickness="0" Background="Transparent"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
